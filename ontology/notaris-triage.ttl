@prefix : <http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix swrlb: <http://www.w3.org/2003/11/swrlb#> .
@prefix lkif-la: <http://www.estrellaproject.org/lkif-core/legal-action.owl#> .
@prefix lkif-action: <http://www.estrellaproject.org/lkif-core/action.owl#> .
@prefix lkif-process: <http://www.estrellaproject.org/lkif-core/process.owl#> .
@prefix lkif-lr: <http://www.estrellaproject.org/lkif-core/legal-role.owl#> .
@prefix lkif-expr: <http://www.estrellaproject.org/lkif-core/expression.owl#> .
@base <http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#> .

<http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage> rdf:type owl:Ontology ;
    owl:imports <http://www.estrellaproject.org/lkif-core/lkif-top.owl> ,
        <http://www.estrellaproject.org/lkif-core/mereology.owl> ,
        <http://www.estrellaproject.org/lkif-core/relative-places.owl> ,
        <http://www.estrellaproject.org/lkif-core/process.owl> ,
        <http://www.estrellaproject.org/lkif-core/time.owl> ,
        <http://www.estrellaproject.org/lkif-core/action.owl> ,
        <http://www.estrellaproject.org/lkif-core/role.owl> ,
        <http://www.estrellaproject.org/lkif-core/expression.owl> ,
        <http://www.estrellaproject.org/lkif-core/legal-action.owl> ,
        <http://www.estrellaproject.org/lkif-core/legal-role.owl> ;
    rdfs:comment "T-Box triase Notaris/PPAT. Berkas ini memuat skema dan aturan. Seluruh individu aplikasi tetap berada di data/abox.ttl dan dimuat terpisah. Satu pengecualian: :trans_warisJual dideklarasikan di sini karena kelas terdefinisi :KasusWarisJual memakai konstruk nominal owl:hasValue, dan konstruk itu wajib menamai satu individu bernama. Nominal inilah yang menaikkan ekspresivitas ke SROIQ(D) (huruf O); lihat blok Individuals di bawah. Kelas domain merujuk LKIF-Core (CC BY 4.0) sebagai legal core ontology; lihat ontology/external/lkif/. Modul lkif-core.owl sengaja tidak diimpor langsung: ia menarik norm.owl, dan Pellet 2.2.0 di Protege tidak selesai mengklasifikasi norm.owl (StackOverflow di blocking saat precompute). Modul LKIF lain diimpor satu per satu supaya closure tetap bersih."@id ;
    rdfs:label "Notaris Triage Ontologi pendamping awam untuk layanan Notaris/PPAT"@id ;
    owl:versionInfo "0.4.0 SROIQ(D): nominal owl:hasValue pada :KasusWarisJual dan rantai properti :dasarKasus" .

#################################################################
#    Annotation properties
#################################################################

###  anotasi domain
:kataKunci rdf:type owl:AnnotationProperty ;
    rdfs:comment "Sinonim dan frasa pemicu pada bahasa awam. Dipakai demo untuk mencocokkan cerita ke kasus, sehingga daftar kata tidak lagi ditulis di kode."@id ;
    rdfs:label "kata kunci"@id .

:prioritas rdf:type owl:AnnotationProperty ;
    rdfs:comment "Angka pemecah seri saat satu cerita cocok ke beberapa kasus. Angka lebih besar diperiksa lebih dulu."@id ;
    rdfs:label "prioritas"@id .

:sumber rdf:type owl:AnnotationProperty ;
    rdfs:comment "Rujukan sumber hukum atau data, misalnya alamat peraturan.go.id."@id ;
    rdfs:label "sumber"@id .


#################################################################
#    Object properties
#################################################################

###  :aktaUntuk
:aktaUntuk rdf:type owl:ObjectProperty ;
    owl:inverseOf :butuhAkta ;
    rdfs:domain :Akta ;
    rdfs:range :KasusTriage ;
    rdfs:label "akta untuk"@id .


###  :berdasarPada
:berdasarPada rdf:type owl:ObjectProperty ;
    rdfs:domain :Akta ;
    rdfs:range :AturanHukum ;
    rdfs:label "berdasar pada"@id .


###  :berstatus
:berstatus rdf:type owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:domain :KasusTriage ;
    rdfs:range :StatusPenanganan ;
    rdfs:comment "Mengikuti slide reasoning: domain dan range dipilih sesempit yang benar, bukan owl:Thing. Functional karena satu kasus punya satu status aktif."@id ;
    rdfs:label "berstatus"@id .


###  :butuhAkta
:butuhAkta rdf:type owl:ObjectProperty ;
    rdfs:domain :KasusTriage ;
    rdfs:range :Akta ;
    rdfs:label "butuh akta"@id .


###  :butuhDokumen
:butuhDokumen rdf:type owl:ObjectProperty ;
    rdfs:domain :KasusTriage ;
    rdfs:range :DokumenSyarat ;
    rdfs:comment "Dokumen yang masih kurang dan harus disiapkan."@id ;
    rdfs:label "butuh dokumen"@id .


###  :dasarKasus
:dasarKasus rdf:type owl:ObjectProperty ;
    owl:propertyChainAxiom ( :butuhAkta :berdasarPada ) ;
    rdfs:domain :KasusTriage ;
    rdfs:range :AturanHukum ;
    rdfs:comment "Rantai properti (huruf R pada SROIQ): bila sebuah kasus butuh akta dan akta itu berdasar pada suatu aturan, maka aturan tersebut menjadi dasar kasus. Contoh: kasus butuh akta_PHB, akta_PHB berdasar aturan_ppat, maka dasarKasus kasus adalah aturan_ppat."@id ;
    rdfs:label "dasar kasus"@id .


###  :dikenaiBiaya
:dikenaiBiaya rdf:type owl:ObjectProperty ;
    rdfs:domain :KasusTriage ;
    rdfs:range :KomponenBiaya ;
    rdfs:label "dikenai biaya"@id .


###  :ditanganiOleh
:ditanganiOleh rdf:type owl:ObjectProperty ,
        owl:FunctionalProperty ;
    owl:inverseOf :menangani ;
    rdfs:domain :KasusTriage ;
    rdfs:range :Lembaga ;
    rdfs:comment "Satu kasus diarahkan ke satu lembaga. Functional supaya badge instansi di demo tunggal dan tidak rancu."@id ;
    rdfs:label "ditangani oleh"@id .


###  :melibatkanTokoh
:melibatkanTokoh rdf:type owl:ObjectProperty ;
    rdfs:domain :KasusTriage ;
    rdfs:range :Tokoh ;
    rdfs:label "melibatkan tokoh"@id .


###  :menangani
:menangani rdf:type owl:ObjectProperty ;
    rdfs:domain :Lembaga ;
    rdfs:range :KasusTriage ;
    rdfs:label "menangani"@id .


###  :perluDaftarDi
:perluDaftarDi rdf:type owl:ObjectProperty ;
    rdfs:domain :Akta ;
    rdfs:range :Lembaga ;
    rdfs:label "perlu daftar di"@id .


###  :punyaJenis
:punyaJenis rdf:type owl:ObjectProperty ;
    rdfs:domain :KasusTriage ;
    rdfs:range :JenisTransaksi ;
    rdfs:label "punya jenis keperluan"@id .


###  :punyaObjek
:punyaObjek rdf:type owl:ObjectProperty ;
    rdfs:domain :KasusTriage ;
    rdfs:range :ObjekHukum ;
    rdfs:label "punya objek"@id .


###  :sudahPunyaDokumen
:sudahPunyaDokumen rdf:type owl:ObjectProperty ;
    rdfs:domain :KasusTriage ;
    rdfs:range :DokumenSyarat ;
    rdfs:label "sudah punya dokumen"@id .


###  :terkaitAturan
:terkaitAturan rdf:type owl:ObjectProperty ,
        owl:TransitiveProperty ;
    rdfs:domain :AturanHukum ;
    rdfs:range :AturanHukum ;
    rdfs:comment "Contoh transitive: bila A terkait B dan B terkait C, maka A terkait C."@id ;
    rdfs:label "terkait aturan"@id .


#################################################################
#    Data properties
#################################################################

###  :adaSKWaris
:adaSKWaris rdf:type owl:DatatypeProperty ;
    rdfs:domain :KasusTriage ;
    rdfs:range xsd:boolean ;
    rdfs:label "ada surat waris"@id .


###  :adaSepakat
:adaSepakat rdf:type owl:DatatypeProperty ;
    rdfs:domain :KasusTriage ;
    rdfs:range xsd:boolean ;
    rdfs:label "ada kesepakatan semua pihak"@id .


###  :adaSertifikat
:adaSertifikat rdf:type owl:DatatypeProperty ;
    rdfs:domain :KasusTriage ;
    rdfs:range xsd:boolean ;
    rdfs:label "ada sertifikat"@id .


###  :cakapHukum
:cakapHukum rdf:type owl:DatatypeProperty ;
    rdfs:domain :KasusTriage ;
    rdfs:range xsd:boolean ;
    rdfs:label "cakap hukum"@id .


###  :jumlahPendiri
:jumlahPendiri rdf:type owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:domain :KasusTriage ;
    rdfs:range xsd:integer ;
    rdfs:label "jumlah pendiri"@id .


###  :modalKecil
:modalKecil rdf:type owl:DatatypeProperty ;
    rdfs:domain :KasusTriage ;
    rdfs:range xsd:boolean ;
    rdfs:label "modal kecil (usaha mikro)"@id .


###  :penjelasanAwam
:penjelasanAwam rdf:type owl:DatatypeProperty ;
    rdfs:domain [ rdf:type owl:Class ;
                  owl:unionOf ( :Akta
                                :AturanHukum
                                :JenisTransaksi
                                :KomponenBiaya
                                :Lembaga
                                :ObjekHukum
                                :StatusPenanganan
                              )
                ] ;
    rdfs:range xsd:string ;
    rdfs:comment "Domain dibatasi union tujuh kelas yang memang punya penjelasan awam: tidak seumum owl:Thing, tidak sesempit satu kelas."@id ;
    rdfs:label "penjelasan awam"@id .


###  :perkiraanBiaya
:perkiraanBiaya rdf:type owl:DatatypeProperty ;
    rdfs:domain :KasusTriage ;
    rdfs:range xsd:string ;
    rdfs:label "perkiraan biaya"@id .


###  :perkiraanWaktu
:perkiraanWaktu rdf:type owl:DatatypeProperty ;
    rdfs:domain :KasusTriage ;
    rdfs:range xsd:string ;
    rdfs:label "perkiraan waktu"@id .


###  :saranLangkah
:saranLangkah rdf:type owl:DatatypeProperty ;
    rdfs:domain :KasusTriage ;
    rdfs:range xsd:string ;
    rdfs:label "saran langkah"@id .


#################################################################
#    Classes
#################################################################

###  :AhliWaris
:AhliWaris rdf:type owl:Class ;
    rdfs:subClassOf :Tokoh ;
    rdfs:label "Ahli waris"@id .


###  :Akta
:Akta rdf:type owl:Class ;
    rdfs:subClassOf lkif-expr:Document ;
    rdfs:comment "Produk hukum: akta jual beli, hibah, fidusia, wasiat, pendirian usaha, dan sejenisnya. Dipetakan ke LKIF expression:Document karena akta adalah dokumen tertulis. Kelas norm:Legal_Document tidak dipakai karena modul norm.owl tidak diimpor (lihat catatan owl:imports)."@id ;
    rdfs:label "Akta dan surat"@id .


###  :AktaBagiWaris
:AktaBagiWaris rdf:type owl:Class ;
    rdfs:subClassOf :Akta ;
    rdfs:label "Akta pembagian hak bersama (APHB)"@id .


###  :AktaCV
:AktaCV rdf:type owl:Class ;
    rdfs:subClassOf :AktaUsaha ;
    rdfs:label "Akta pendirian CV"@id .


###  :AktaFidusia
:AktaFidusia rdf:type owl:Class ;
    rdfs:subClassOf :AktaJaminan ;
    rdfs:label "Akta fidusia"@id .


###  :AktaHibahTanah
:AktaHibahTanah rdf:type owl:Class ;
    rdfs:subClassOf :Akta ;
    rdfs:label "Akta hibah tanah"@id .


###  :AktaJaminan
:AktaJaminan rdf:type owl:Class ;
    rdfs:subClassOf :Akta ;
    rdfs:label "Akta jaminan utang"@id .


###  :AktaJualBeli
:AktaJualBeli rdf:type owl:Class ;
    rdfs:subClassOf :Akta ;
    rdfs:label "Akta jual beli (AJB)"@id .


###  :AktaPTBiasa
:AktaPTBiasa rdf:type owl:Class ;
    rdfs:subClassOf :AktaUsaha ;
    rdfs:label "Akta pendirian PT biasa"@id .


###  :AktaPTPerorangan
:AktaPTPerorangan rdf:type owl:Class ;
    rdfs:subClassOf :AktaUsaha ;
    rdfs:label "Pernyataan PT perorangan"@id .


###  :AktaPerjanjianKawin
:AktaPerjanjianKawin rdf:type owl:Class ;
    rdfs:subClassOf :Akta ;
    rdfs:label "Akta perjanjian kawin"@id .


###  :AktaHakTanggungan
:AktaHakTanggungan rdf:type owl:Class ;
    rdfs:subClassOf :AktaJaminan ,
        [ rdf:type owl:Restriction ;
          owl:onProperty :perluDaftarDi ;
          owl:someValuesFrom :Lembaga
        ] ;
    rdfs:comment "Akta pokok pembebanan Hak Tanggungan atas tanah (UUHT No.4/1996): dibuat di hadapan PPAT dan wajib didaftarkan ke BPN. Berbeda dengan SKMHT yang hanya kuasa pendahulunya. Restriction someValuesFrom menegaskan akta ini selalu terdaftar di suatu lembaga."@id ;
    rdfs:label "Akta Pemberian Hak Tanggungan (APHT)"@id .


###  :SuratKuasaMembebankan
:SuratKuasaMembebankan rdf:type owl:Class ;
    rdfs:subClassOf :Akta ,
        [ rdf:type owl:Restriction ;
          owl:onProperty :berdasarPada ;
          owl:someValuesFrom :AturanHukum
        ] ;
    rdfs:comment "SKMHT bukan akta jaminan: kuasa otentik untuk memasang APHT, dibuat di hadapan Notaris/PPAT, dan wajib diikuti APHT dalam batas waktu UUHT. SKMHT sendiri tidak didaftarkan ke BPN."@id ;
    rdfs:label "SKMHT, kuasa membebankan Hak Tanggungan"@id .


###  :AktaUsaha
:AktaUsaha rdf:type owl:Class ;
    rdfs:subClassOf :Akta ;
    rdfs:label "Akta usaha"@id .


###  :AktaWasiat
:AktaWasiat rdf:type owl:Class ;
    rdfs:subClassOf :Akta ;
    rdfs:label "Akta wasiat"@id .


###  :AturanHukum
:AturanHukum rdf:type owl:Class ;
    rdfs:subClassOf lkif-expr:Document ;
    rdfs:comment "Dasar hukum: UUJN, aturan PPAT, KUHPerdata, KHI. Dipetakan ke LKIF expression:Document: peraturan adalah dokumen hukum tertulis. Kelas norm:Legal_Source tidak dipakai karena modul norm.owl tidak diimpor (lihat catatan owl:imports)."@id ;
    rdfs:label "Aturan hukum"@id .


###  :CeritaAwam
:CeritaAwam rdf:type owl:Class ;
    rdfs:comment "Ungkapan masalah dalam bahasa sehari-hari, misalnya mau jual tanah warisan."@id ;
    rdfs:label "Cerita awam"@id .


###  :DokumenSyarat
:DokumenSyarat rdf:type owl:Class ;
    rdfs:subClassOf lkif-expr:Document ;
    rdfs:comment "Berkas yang harus dibawa: KTP, sertifikat, PBB, dan sejenisnya. Dipetakan ke LKIF expression:Document."@id ;
    rdfs:label "Dokumen syarat"@id .


###  :JenisTransaksi
:JenisTransaksi rdf:type owl:Class ;
    rdfs:subClassOf lkif-action:Transaction ;
    rdfs:comment "Kategori kebutuhan awam: jual beli, waris, hibah, usaha, utang, wasiat, kawin. Dipetakan ke LKIF action:Transaction."@id ;
    rdfs:label "Jenis keperluan"@id .


###  :KasusTriage
:KasusTriage rdf:type owl:Class ;
    rdfs:subClassOf :PeristiwaHukum ,
        [ rdf:type owl:Restriction ;
          owl:onProperty :punyaJenis ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass :JenisTransaksi
        ] ;
    rdfs:comment "Hasil pemetaan cerita awam menjadi peristiwa hukum yang siap ditangani. Setiap kasus tepat satu jenis keperluan, ditegaskan lewat restriction cardinality."@id ;
    rdfs:label "Kasus triase"@id .


###  :KasusWarisJual
:KasusWarisJual rdf:type owl:Class ;
    owl:equivalentClass [ rdf:type owl:Class ;
                          owl:intersectionOf ( :KasusTriage
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty :punyaJenis ;
                                                 owl:hasValue :trans_warisJual
                                               ]
                                             )
                        ] ;
    rdfs:comment "Kelas terdefinisi: kasus triase yang jenisnya persis warisJual. Memakai owl:hasValue (nominal, huruf O pada SROIQ), sehingga Pellet dapat mengenali otomatis semua kasus berjenis warisJual tanpa aturan SWRL tambahan."@id ;
    rdfs:label "Kasus waris yang lalu dijual"@id .


###  :KomponenBiaya
:KomponenBiaya rdf:type owl:Class ;
    rdfs:comment "Honorarium, pajak, dan PNBP yang mungkin muncul."@id ;
    rdfs:label "Komponen biaya"@id .


###  :Lembaga
:Lembaga rdf:type owl:Class ;
    rdfs:subClassOf lkif-action:Organisation ;
    rdfs:comment "Tempat mengurus: kantor notaris, PPAT, pengadilan, BPN, AHU, Dukcapil. Dipetakan ke LKIF action:Organisation."@id ;
    rdfs:label "Lembaga berwenang"@id .


###  :ObjekHukum
:ObjekHukum rdf:type owl:Class ;
    rdfs:subClassOf lkif-process:Physical_Object ;
    rdfs:comment "Benda atau hak yang diurus: tanah, bangunan, kendaraan, saham. Dipetakan ke LKIF action:Physical_Object."@id ;
    rdfs:label "Objek hukum"@id .


###  :PejabatNotaris
:PejabatNotaris rdf:type owl:Class ;
    rdfs:subClassOf lkif-lr:Professional_Legal_Role ;
    rdfs:comment "Peran, bukan orang. Sensor penting: LKIF menyatakan Agent dan Role saling lepas, jadi kelas peran tidak boleh sekaligus subclass Tokoh (Agent)."@id ;
    rdfs:label "Peran pejabat notaris"@id .


###  :PejabatPPAT
:PejabatPPAT rdf:type owl:Class ;
    rdfs:subClassOf lkif-lr:Professional_Legal_Role ;
    rdfs:label "Peran pejabat PPAT"@id .


###  :PeristiwaHukum
:PeristiwaHukum rdf:type owl:Class ;
    rdfs:subClassOf lkif-la:Act_of_Law ;
    rdfs:comment "Kejadian yang menimbulkan akibat hukum, misalnya jual beli atau pewarisan. Dipetakan ke LKIF legal-action:Act_of_Law."@id ;
    rdfs:label "Peristiwa hukum"@id .


###  :SaksiAkta
:SaksiAkta rdf:type owl:Class ;
    rdfs:subClassOf lkif-lr:Legal_Role ;
    rdfs:label "Peran saksi akta"@id .


###  :StatusPenanganan
:StatusPenanganan rdf:type owl:Class ;
    rdfs:comment "Posisi kasus: belum lengkap, siap ke notaris/PPAT, rujuk pengadilan, tuntas."@id ;
    rdfs:label "Status penanganan"@id .


###  :SuratWaris
:SuratWaris rdf:type owl:Class ;
    rdfs:subClassOf :Akta ;
    rdfs:label "Surat keterangan waris"@id .


###  :Tokoh
:Tokoh rdf:type owl:Class ;
    rdfs:subClassOf lkif-action:Agent ;
    rdfs:comment "Orang yang terlibat: warga, ahli waris. Dipetakan ke LKIF action:Agent."@id ;
    rdfs:label "Tokoh"@id .


###  :WargaAwam
:WargaAwam rdf:type owl:Class ;
    rdfs:subClassOf :Tokoh ,
        lkif-la:Natural_Person ;
    rdfs:label "Warga awam"@id .


###  :UndangUndang
:UndangUndang rdf:type owl:Class ;
    rdfs:subClassOf :AturanHukum ;
    rdfs:comment "Undang-undang sebagai dokumen hukum tertulis; sifat LKIF diwarisi lewat :AturanHukum."@id ;
    rdfs:label "Undang-undang"@id .


###  :PeraturanPemerintah
:PeraturanPemerintah rdf:type owl:Class ;
    rdfs:subClassOf :AturanHukum ;
    rdfs:comment "Peraturan pemerintah sebagai dokumen hukum tertulis; sifat LKIF diwarisi lewat :AturanHukum."@id ;
    rdfs:label "Peraturan pemerintah"@id .


#################################################################
#    Individuals
#    Hanya satu individu di T-Box, dan itu disengaja.
#    Kelas terdefinisi :KasusWarisJual memakai owl:hasValue
#    (nominal), yang wajib menamai individu bernama; tanpa
#    individu ini ekspresivitas berhenti di SHIQ(D).
#    Semua individu aplikasi lain tetap di data/abox.ttl.
#################################################################

###  :trans_warisJual
:trans_warisJual rdf:type owl:NamedIndividual ,
        :JenisTransaksi .


#################################################################
#    SWRL rules R1-R8
#    Gaya mengikuti slide 8: badan memuat atom kelas dan atom
#    properti (objek maupun data), kepala memuat fakta baru.
#    Mesin penalar: Pellet di Protégé (bukan dari Python).
#################################################################

###  R1
[ a swrl:Imp ;
    rdfs:label "R1 - Jual beli tanah bersertifikat dan sepakat ke PPAT dengan AJB"@id ;
    rdfs:comment "Jika jenis jualBeli, objek tanahSHM, ada sertifikat, dan sepakat, maka arahkan ke PPAT dengan AJB."@id ;
    swrl:body [ a swrl:AtomList ;
          rdf:first [ a swrl:ClassAtom ; swrl:classPredicate :KasusTriage ; swrl:argument1 :var_k ] ;
          rdf:rest [ a swrl:AtomList ;
                      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :punyaJenis ; swrl:argument1 :var_k ; swrl:argument2 :trans_jualBeli ] ;
                      rdf:rest [ a swrl:AtomList ;
                                  rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :punyaObjek ; swrl:argument1 :var_k ; swrl:argument2 :obj_tanahSHM ] ;
                                  rdf:rest [ a swrl:AtomList ;
                                              rdf:first [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :adaSertifikat ; swrl:argument1 :var_k ; swrl:argument2 true ] ;
                                              rdf:rest [ a swrl:AtomList ;
                                                          rdf:first [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :adaSepakat ; swrl:argument1 :var_k ; swrl:argument2 true ] ;
                                                          rdf:rest rdf:nil ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
          rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :ditanganiOleh ; swrl:argument1 :var_k ; swrl:argument2 :lem_ppat ] ;
          rdf:rest [ a swrl:AtomList ;
                      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :butuhAkta ; swrl:argument1 :var_k ; swrl:argument2 :akta_AJB ] ;
                      rdf:rest rdf:nil ] ] ] .


###  R2
[ a swrl:Imp ;
    rdfs:label "R2 - Warisan tanpa SKW berarti belum lengkap"@id ;
    rdfs:comment "Jika jenis warisJual dan belum ada SKW, maka status belum lengkap dan butuh dokumen SKW."@id ;
    swrl:body [ a swrl:AtomList ;
          rdf:first [ a swrl:ClassAtom ; swrl:classPredicate :KasusTriage ; swrl:argument1 :var_k ] ;
          rdf:rest [ a swrl:AtomList ;
                      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :punyaJenis ; swrl:argument1 :var_k ; swrl:argument2 :trans_warisJual ] ;
                      rdf:rest [ a swrl:AtomList ;
                                  rdf:first [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :adaSKWaris ; swrl:argument1 :var_k ; swrl:argument2 false ] ;
                                  rdf:rest rdf:nil ] ] ] ;
    swrl:head [ a swrl:AtomList ;
          rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :berstatus ; swrl:argument1 :var_k ; swrl:argument2 :status_belumLengkap ] ;
          rdf:rest [ a swrl:AtomList ;
                      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :butuhDokumen ; swrl:argument1 :var_k ; swrl:argument2 :dok_SKWaris ] ;
                      rdf:rest rdf:nil ] ] ] .


###  R3
[ a swrl:Imp ;
    rdfs:label "R3 - Waris tidak sepakat rujuk pengadilan"@id ;
    rdfs:comment "Jika jenis warisBagi dan para pihak tidak sepakat, maka rujuk pengadilan atau mediasi."@id ;
    swrl:body [ a swrl:AtomList ;
          rdf:first [ a swrl:ClassAtom ; swrl:classPredicate :KasusTriage ; swrl:argument1 :var_k ] ;
          rdf:rest [ a swrl:AtomList ;
                      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :punyaJenis ; swrl:argument1 :var_k ; swrl:argument2 :trans_warisBagi ] ;
                      rdf:rest [ a swrl:AtomList ;
                                  rdf:first [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :adaSepakat ; swrl:argument1 :var_k ; swrl:argument2 false ] ;
                                  rdf:rest rdf:nil ] ] ] ;
    swrl:head [ a swrl:AtomList ;
          rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :ditanganiOleh ; swrl:argument1 :var_k ; swrl:argument2 :lem_pengadilan ] ;
          rdf:rest [ a swrl:AtomList ;
                      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :berstatus ; swrl:argument1 :var_k ; swrl:argument2 :status_rujukPengadilan ] ;
                      rdf:rest rdf:nil ] ] ] .


###  R4
[ a swrl:Imp ;
    rdfs:label "R4 - Hibah tanah ke PPAT dengan BPHTB"@id ;
    rdfs:comment "Jika jenis hibah dan objek tanahSHM, maka ke PPAT dengan akta hibah dan kena BPHTB."@id ;
    swrl:body [ a swrl:AtomList ;
          rdf:first [ a swrl:ClassAtom ; swrl:classPredicate :KasusTriage ; swrl:argument1 :var_k ] ;
          rdf:rest [ a swrl:AtomList ;
                      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :punyaJenis ; swrl:argument1 :var_k ; swrl:argument2 :trans_hibah ] ;
                      rdf:rest [ a swrl:AtomList ;
                                  rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :punyaObjek ; swrl:argument1 :var_k ; swrl:argument2 :obj_tanahSHM ] ;
                                  rdf:rest rdf:nil ] ] ] ;
    swrl:head [ a swrl:AtomList ;
          rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :ditanganiOleh ; swrl:argument1 :var_k ; swrl:argument2 :lem_ppat ] ;
          rdf:rest [ a swrl:AtomList ;
                      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :butuhAkta ; swrl:argument1 :var_k ; swrl:argument2 :akta_hibah ] ;
                      rdf:rest [ a swrl:AtomList ;
                                  rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :dikenaiBiaya ; swrl:argument1 :var_k ; swrl:argument2 :biaya_BPHTB ] ;
                                  rdf:rest rdf:nil ] ] ] ] .


###  R5
[ a swrl:Imp ;
    rdfs:label "R5 - Usaha satu pendiri modal kecil ke PT perorangan"@id ;
    rdfs:comment "Jika jenis dirikanUsaha dengan satu pendiri dan modal kecil, maka ke PT perorangan lewat AHU."@id ;
    swrl:body [ a swrl:AtomList ;
          rdf:first [ a swrl:ClassAtom ; swrl:classPredicate :KasusTriage ; swrl:argument1 :var_k ] ;
          rdf:rest [ a swrl:AtomList ;
                      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :punyaJenis ; swrl:argument1 :var_k ; swrl:argument2 :trans_dirikanUsaha ] ;
                      rdf:rest [ a swrl:AtomList ;
                                  rdf:first [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :jumlahPendiri ; swrl:argument1 :var_k ; swrl:argument2 1 ] ;
                                  rdf:rest [ a swrl:AtomList ;
                                              rdf:first [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :modalKecil ; swrl:argument1 :var_k ; swrl:argument2 true ] ;
                                              rdf:rest rdf:nil ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
          rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :butuhAkta ; swrl:argument1 :var_k ; swrl:argument2 :akta_PTperorangan ] ;
          rdf:rest [ a swrl:AtomList ;
                      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :ditanganiOleh ; swrl:argument1 :var_k ; swrl:argument2 :lem_ahu ] ;
                      rdf:rest rdf:nil ] ] ] .


###  R6
[ a swrl:Imp ;
    rdfs:label "R6 - Utang jaminan kendaraan ke notaris fidusia"@id ;
    rdfs:comment "Jika jenis utangJaminan dan objek kendaraan, maka ke notaris dengan akta fidusia."@id ;
    swrl:body [ a swrl:AtomList ;
          rdf:first [ a swrl:ClassAtom ; swrl:classPredicate :KasusTriage ; swrl:argument1 :var_k ] ;
          rdf:rest [ a swrl:AtomList ;
                      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :punyaJenis ; swrl:argument1 :var_k ; swrl:argument2 :trans_utangJaminan ] ;
                      rdf:rest [ a swrl:AtomList ;
                                  rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :punyaObjek ; swrl:argument1 :var_k ; swrl:argument2 :obj_kendaraan ] ;
                                  rdf:rest rdf:nil ] ] ] ;
    swrl:head [ a swrl:AtomList ;
          rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :ditanganiOleh ; swrl:argument1 :var_k ; swrl:argument2 :lem_notaris ] ;
          rdf:rest [ a swrl:AtomList ;
                      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :butuhAkta ; swrl:argument1 :var_k ; swrl:argument2 :akta_fidusia ] ;
                      rdf:rest rdf:nil ] ] ] .


###  R7
[ a swrl:Imp ;
    rdfs:label "R7 - Wasiat cakap hukum ke notaris"@id ;
    rdfs:comment "Jika jenis wasiat dan pemberi cakap hukum, maka ke notaris dengan akta wasiat."@id ;
    swrl:body [ a swrl:AtomList ;
          rdf:first [ a swrl:ClassAtom ; swrl:classPredicate :KasusTriage ; swrl:argument1 :var_k ] ;
          rdf:rest [ a swrl:AtomList ;
                      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :punyaJenis ; swrl:argument1 :var_k ; swrl:argument2 :trans_wasiat ] ;
                      rdf:rest [ a swrl:AtomList ;
                                  rdf:first [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :cakapHukum ; swrl:argument1 :var_k ; swrl:argument2 true ] ;
                                  rdf:rest rdf:nil ] ] ] ;
    swrl:head [ a swrl:AtomList ;
          rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :ditanganiOleh ; swrl:argument1 :var_k ; swrl:argument2 :lem_notaris ] ;
          rdf:rest [ a swrl:AtomList ;
                      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :butuhAkta ; swrl:argument1 :var_k ; swrl:argument2 :akta_wasiat ] ;
                      rdf:rest rdf:nil ] ] ] .


###  R8
[ a swrl:Imp ;
    rdfs:label "R8 - Atur harta kawin sepakat ke notaris"@id ;
    rdfs:comment "Jika jenis kawinHarta, cakap hukum, dan pasangan sepakat, maka ke notaris dengan akta perjanjian kawin."@id ;
    swrl:body [ a swrl:AtomList ;
          rdf:first [ a swrl:ClassAtom ; swrl:classPredicate :KasusTriage ; swrl:argument1 :var_k ] ;
          rdf:rest [ a swrl:AtomList ;
                      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :punyaJenis ; swrl:argument1 :var_k ; swrl:argument2 :trans_kawinHarta ] ;
                      rdf:rest [ a swrl:AtomList ;
                                  rdf:first [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :cakapHukum ; swrl:argument1 :var_k ; swrl:argument2 true ] ;
                                  rdf:rest [ a swrl:AtomList ;
                                              rdf:first [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :adaSepakat ; swrl:argument1 :var_k ; swrl:argument2 true ] ;
                                              rdf:rest rdf:nil ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
          rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :ditanganiOleh ; swrl:argument1 :var_k ; swrl:argument2 :lem_notaris ] ;
          rdf:rest [ a swrl:AtomList ;
                      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :butuhAkta ; swrl:argument1 :var_k ; swrl:argument2 :akta_kawin ] ;
                      rdf:rest rdf:nil ] ] ] .


###  variabel
:var_k a swrl:Variable ;
    rdfs:label "kasus"@id .


#################################################################
#    General axioms (disjointness)
#    Slide Ontology Engineering: "Don't forget disjointness."
#    Hanya kelas sekategori yang dibuat saling lepas.
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :AktaBagiWaris
                :AktaFidusia
                :AktaHakTanggungan
                :AktaHibahTanah
                :AktaJualBeli
                :AktaPerjanjianKawin
                :AktaWasiat
                :SuratKuasaMembebankan
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :AktaCV
                :AktaPTBiasa
                :AktaPTPerorangan
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :PejabatNotaris
                :PejabatPPAT
                :SaksiAkta
              )
] .
