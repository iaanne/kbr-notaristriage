:lem_ppat rdf:type owl:NamedIndividual ,
                   :Lembaga ;
          :penjelasanAwam "Pejabat khusus tanah: AJB, hibah tanah, APHB, tanggungan." ;
          rdfs:label "kantor PPAT"@id .


#################################################################
#    Objek hukum
#################################################################

:obj_bangunan rdf:type owl:NamedIndividual ,
                       :ObjekHukum ;
              :penjelasanAwam "Rumah, ruko, atau bangunan di atas sebidang tanah." ;
              rdfs:label "bangunan"@id .


:obj_hartaKawin rdf:type owl:NamedIndividual ,
                         :ObjekHukum ;
                :penjelasanAwam "Harta yang terbentuk selama perkawinan, termasuk yang baru dipakai bersama." ;
                rdfs:label "harta kawin"@id .


:obj_kendaraan rdf:type owl:NamedIndividual ,
                        :ObjekHukum ;
               :penjelasanAwam "Motor, mobil, atau kendaraan lain yang mempunyai BPKB." ;
               rdfs:label "kendaraan bermotor"@id .


:obj_mesinUsaha rdf:type owl:NamedIndividual ,
                         :ObjekHukum ;
                :penjelasanAwam "Peralatan dan stok yang dipakai untuk menjalankan usaha." ;
                rdfs:label "mesin dan stok usaha"@id .


:obj_sahamUsaha rdf:type owl:NamedIndividual ,
                         :ObjekHukum ;
                :penjelasanAwam "Kepemilikan saham atau bagian di dalam sebuah perusahaan." ;
                rdfs:label "saham usaha"@id .


:obj_tanahHGB rdf:type owl:NamedIndividual ,
                       :ObjekHukum ;
              :penjelasanAwam "Tanah Hak Guna Bangunan, biasa untuk ruko atau perusahaan." ;
              rdfs:label "tanah HGB"@id .


:obj_tanahSHM rdf:type owl:NamedIndividual ,
                       :ObjekHukum ;
              :penjelasanAwam "Tanah yang sudah bersertifikat Hak Milik." ;
              rdfs:label "tanah SHM"@id .


:obj_tanahWaris rdf:type owl:NamedIndividual ,
                         :ObjekHukum ;
                :penjelasanAwam "Tanah peninggalan yang belum dibagi." ;
                rdfs:label "tanah warisan"@id .


#################################################################
#    Status penanganan
#################################################################

:status_belumLengkap rdf:type owl:NamedIndividual ,
                              :StatusPenanganan ;
                     :penjelasanAwam "Masih ada dokumen atau syarat kurang, belum bisa ke pejabat." ;
                     rdfs:label "belum lengkap"@id .


:status_perluCekDok rdf:type owl:NamedIndividual ,
                             :StatusPenanganan ;
                    :penjelasanAwam "Berkas belum lengkap; ada dokumen yang kurang atau belum berlaku." ;
                    rdfs:label "perlu cek dokumen"@id .


:status_rujukPengadilan rdf:type owl:NamedIndividual ,
                                 :StatusPenanganan ;
                        :penjelasanAwam "Para pihak tidak sepakat; perlu mediasi dulu sebelum ke pengadilan." ;
                        rdfs:label "rujuk pengadilan/mediasi"@id .


:status_siapNotaris rdf:type owl:NamedIndividual ,
                             :StatusPenanganan ;
                    :penjelasanAwam "Berkas sudah cukup; silakan datang bawa dokumennya ke notaris." ;
                    rdfs:label "siap ke notaris"@id .


:status_siapPPAT rdf:type owl:NamedIndividual ,
                          :StatusPenanganan ;
                 :penjelasanAwam "Berkas sudah cukup; silakan datang ke kantor PPAT untuk akta." ;
                 rdfs:label "siap ke PPAT"@id .


:status_tuntasAwal rdf:type owl:NamedIndividual ,
                            :StatusPenanganan ;
                   :penjelasanAwam "Tuntas di tahap awal: instansi dan akta sudah jelas, tinggal eksekusi berkas." ;
                   rdfs:label "tuntas tahap awal"@id .


#################################################################
#    Surat
#################################################################

:surat_SKW rdf:type owl:NamedIndividual ,
                    :SuratWaris ;
           :penjelasanAwam "Surat siapa saja ahli warisnya, dibuat di kelurahan/notaris/balai harta." ;
           rdfs:label "Surat keterangan waris"@id .


#################################################################
#    Jenis keperluan
#################################################################

:trans_dirikanUsaha rdf:type owl:NamedIndividual ,
                             :JenisTransaksi ;
                    :penjelasanAwam "Mau bikin usaha resmi: PT perorangan, PT biasa, atau CV." ;
                    rdfs:label "dirikan usaha"@id .


:trans_hibah rdf:type owl:NamedIndividual ,
                      :JenisTransaksi ;
             :penjelasanAwam "Pemberian tanah cuma-cuma ke anak atau kerabat selagi hidup." ;
             rdfs:label "hibah tanah"@id .


:trans_jualBeli rdf:type owl:NamedIndividual ,
                         :JenisTransaksi ;
                :penjelasanAwam "Ada penjual dan pembeli tanah, mau pindah nama sertifikat." ;
                rdfs:label "jual beli tanah"@id .


:trans_kawinHarta rdf:type owl:NamedIndividual ,
                           :JenisTransaksi ;
                  :penjelasanAwam "Calon suami istri mau atur pisah atau gabung harta." ;
                  rdfs:label "atur harta kawin"@id .


:trans_utangJaminan rdf:type owl:NamedIndividual ,
                             :JenisTransaksi ;
                    :penjelasanAwam "Pinjam uang dengan jaminan motor, mesin, atau stok dagangan." ;
                    rdfs:label "utang dengan jaminan"@id .


:trans_warisBagi rdf:type owl:NamedIndividual ,
                          :JenisTransaksi ;
                 :penjelasanAwam "Keluarga mau membagi harta peninggalan secara resmi." ;
                 rdfs:label "bagi waris"@id .


:trans_warisJual rdf:type owl:NamedIndividual ,
                          :JenisTransaksi ;
                 :penjelasanAwam "Tanah peninggalan keluarga mau dijual, belum tentu sudah balik nama." ;
                 rdfs:label "jual tanah warisan"@id .


:trans_wasiat rdf:type owl:NamedIndividual ,
                       :JenisTransaksi ;
              :penjelasanAwam "Pesan terakhir tentang siapa dapat apa setelah meninggal." ;
              rdfs:label "wasiat"@id .


#################################################################
#    Kasus triase
#    Setiap kasus membawa anotasi :kataKunci (frasa pemicu pada bahasa
#    awam) dan :prioritas (pemecah seri bila satu cerita cocok ke
#    beberapa kasus; angka lebih besar diperiksa lebih dulu). Anotasi
#    inilah pengganti daftar POLA yang dulu ditulis di demo/app.py.
#################################################################

:kasus_jualbeli_shm rdf:type owl:NamedIndividual ,
                             :KasusTriage ;
                    :berstatus :status_siapPPAT ;
                    :butuhAkta :akta_AJB ;
                    :butuhDokumen :dok_NPWP ,
                                  :dok_PBB ,
                                  :dok_SHM ;
                    :dasarKasus :aturan_ppat ,
                                :aturan_tanah ;
                    :dikenaiBiaya :biaya_BPHTB ,
                                  :biaya_PNBP_BPN ,
                                  :biaya_PPh ,
                                  :biaya_honorPPAT ;
                    :ditanganiOleh :lem_ppat ;
                    :punyaJenis :trans_jualBeli ;
                    :punyaObjek :obj_tanahSHM ;
                    :sudahPunyaDokumen :dok_KK ,
                                       :dok_KTP ;
                    :adaSepakat "true"^^xsd:boolean ;
                    :adaSertifikat "true"^^xsd:boolean ;
                    :cakapHukum "true"^^xsd:boolean ;
                    :kataKunci "jual" ,
                               "beli" ,
                               "jual beli" ,
                               "ajb" ,
                               "balik nama" ,
                               "shm" ,
                               "sertifikat" ,
                               "tanah" ;
                    :perkiraanBiaya "Honor PPAT + BPHTB (±5% NPOP-NPOPTKP) + PPh 2,5% + PNBP BPN." ;
                    :perkiraanWaktu "AJB 1-7 hari bila berkas lengkap; balik nama BPN 5-14 hari." ;
                    :prioritas 30 ;
                    :saranLangkah "Lengkapi SHM + PBB, cek keaslian di BPN, tanda tangan AJB di PPAT, lalu balik nama." ;
                    rdfs:label "Kasus 1: jual beli SHM biasa"@id .


:kasus_waris_belumSKW rdf:type owl:NamedIndividual ,
                               :KasusTriage ;
                      :berstatus :status_belumLengkap ;
                      :butuhAkta :akta_AJB ;
                      :butuhDokumen :dok_PBB ,
                                    :dok_SHM ,
                                    :dok_SKWaris ;
                      :dasarKasus :aturan_ppat ,
                                  :aturan_warisPerdata ;
                      :dikenaiBiaya :biaya_BPHTB ,
                                    :biaya_honorPPAT ;
                      :ditanganiOleh :lem_ppat ;
                      :punyaJenis :trans_warisJual ;
                      :punyaObjek :obj_tanahWaris ;
                      :sudahPunyaDokumen :dok_AktaKematian ,
                                         :dok_KTP ;
                      :adaSKWaris "false"^^xsd:boolean ;
                      :adaSepakat "true"^^xsd:boolean ;
                      :adaSertifikat "true"^^xsd:boolean ;
                      :cakapHukum "true"^^xsd:boolean ;
                      :kataKunci "waris" ,
                                 "warisan" ,
                                 "ahli waris" ,
                                 "peninggalan" ,
                                 "belum balik nama" ,
                                 "skw" ,
                                 "surat keterangan waris" ;
                      :perkiraanBiaya "Biaya SKW kecil; AJB + BPHTB + PPh waris bila ada." ;
                      :perkiraanWaktu "SKW 7-14 hari; AJB setelahnya 1-7 hari." ;
                      :prioritas 70 ;
                      :saranLangkah "Urus SK waris dulu (kelurahan/notaris), baru bisa AJB. Jangan tanda tangan apa pun sebelum SKW jadi." ;
                      rdfs:label "Kasus 2: jual warisan belum ada SKW"@id .


:kasus_waris_sengketa rdf:type owl:NamedIndividual ,
                               :KasusTriage ;
                      :berstatus :status_rujukPengadilan ;
                      :butuhAkta :akta_PHB ;
                      :butuhDokumen :dok_SKWaris ,
                                    :dok_AktaKematian ,
                                    :dok_KTP ,
                                    :dok_KK ;
                      :sudahPunyaDokumen :dok_KTP ,
                                         :dok_KK ;
                      :ditanganiOleh :lem_pengadilan ;
                      :punyaJenis :trans_warisBagi ;
                      :punyaObjek :obj_tanahWaris ;
                      :adaSKWaris "false"^^xsd:boolean ;
                      :adaSepakat "false"^^xsd:boolean ;
                      :adaSertifikat "true"^^xsd:boolean ;
