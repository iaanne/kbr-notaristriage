:biaya_PPh rdf:type owl:NamedIndividual ,
                    :KomponenBiaya ;
           :penjelasanAwam "Pajak penghasilan dari sisi penjual, umumnya 2,5% dari nilai jual." ;
           rdfs:label "PPh penjual"@id .


:biaya_honorNotaris rdf:type owl:NamedIndividual ,
                             :KomponenBiaya ;
                    :penjelasanAwam "Honor jasa notaris untuk akta yang dibuatnya." ;
