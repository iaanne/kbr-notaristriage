@prefix : <http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage/data> rdf:type owl:Ontology ;
    owl:imports <http://www.semanticweb.org/iaanne/ontologies/2026/notaris-triage> ;
    rdfs:comment "A-Box triase Notaris/PPAT: seluruh individu (kasus, akta, lembaga, dokumen, objek, status, jenis keperluan, aturan) beserta fakta dan anotasinya. Skema tetap di ontology/notaris-triage.ttl, jadi berkas ini hanya data. Dimuat bersama skema oleh Pellet di Protege. Sebagian triple pada tiap kasus (ditanganiOleh, butuhAkta, berstatus, dikenaiBiaya, butuhDokumen) sama persis dengan kepala aturan R1 sampai R8: di sini mereka diassert sebagai pengetahuan, sedangkan Pellet dapat menurunkannya kembali dari fakta masukan kasus. Anotasi :kataKunci dan :prioritas dipakai demo untuk mencocokkan cerita awam ke kasus, sehingga daftar kata tidak ditulis di kode Python."@id ;
    rdfs:label "Notaris Triage A-Box"@id .


#################################################################
#    Akta dan surat
#################################################################

:akta_AJB rdf:type owl:NamedIndividual ,
                   :AktaJualBeli ;
          :berdasarPada :aturan_ppat ,
                        :aturan_tanah ;
          :perluDaftarDi :lem_bpn ;
          :penjelasanAwam "Akta jual beli tanah di depan PPAT, lalu balik nama di BPN." ;
          rdfs:label "AJB"@id .


:akta_APHT rdf:type owl:NamedIndividual ,
                    :AktaHakTanggungan ;
           :berdasarPada :aturan_uuht ;
           :perluDaftarDi :lem_bpn ;
           :penjelasanAwam "Akta pokok jaminan tanah untuk kredit bank: dibuat di PPAT lalu didaftar ke BPN. Didahului SKMHT bila pemilik tidak hadir." ;
           rdfs:label "APHT"@id .


:akta_CV rdf:type owl:NamedIndividual ,
                  :AktaCV ;
         :perluDaftarDi :lem_ahu ;
         :penjelasanAwam "Persekutuan komanditer untuk usaha kecil menengah." ;
         rdfs:label "CV"@id .


:akta_PHB rdf:type owl:NamedIndividual ,
                   :AktaBagiWaris ;
          :berdasarPada :aturan_ppat ;
          :perluDaftarDi :lem_bpn ;
          :penjelasanAwam "Akta pembagian hak bersama untuk waris yang sudah sepakat." ;
          rdfs:label "APHB"@id .


:akta_PTbiasa rdf:type owl:NamedIndividual ,
                       :AktaPTBiasa ;
              :berdasarPada :aturan_pt ;
              :perluDaftarDi :lem_ahu ;
              :penjelasanAwam "Perseroan 2+ pendiri dengan akta notaris." ;
              rdfs:label "PT biasa"@id .


:akta_PTperorangan rdf:type owl:NamedIndividual ,
                            :AktaPTPerorangan ;
                   :berdasarPada :aturan_pt ;
                   :perluDaftarDi :lem_ahu ;
                   :penjelasanAwam "Badan usaha 1 orang, daftar online ke AHU, cocok untuk mikro." ;
                   rdfs:label "PT perorangan"@id .


:akta_SKMHT rdf:type owl:NamedIndividual ,
                     :SuratKuasaMembebankan ;
            :berdasarPada :aturan_uuht ;
            :penjelasanAwam "Kuasa otentik agar bank/notaris bisa memasang APHT. Bukan jaminan itu sendiri dan tidak didaftar ke BPN; wajib disusul APHT." ;
            rdfs:label "SKMHT"@id .


:akta_fidusia rdf:type owl:NamedIndividual ,
                       :AktaFidusia ;
              :berdasarPada :aturan_fidusia ;
              :perluDaftarDi :lem_ahu ;
              :penjelasanAwam "Jaminan tanpa serah barang: motor tetap dipakai tapi terikat utang." ;
              rdfs:label "Akta fidusia"@id .


:akta_hibah rdf:type owl:NamedIndividual ,
                     :AktaHibahTanah ;
            :berdasarPada :aturan_ppat ;
            :perluDaftarDi :lem_bpn ;
            :penjelasanAwam "Akta pemberian tanah cuma-cuma, dibuat di PPAT." ;
            rdfs:label "Akta hibah"@id .


:akta_kawin rdf:type owl:NamedIndividual ,
                     :AktaPerjanjianKawin ;
            :berdasarPada :aturan_kawin ;
            :perluDaftarDi :lem_dukcapil ;
            :penjelasanAwam "Atur pisah harta, dibuat di notaris lalu dicatat di Dukcapil." ;
            rdfs:label "Perjanjian kawin"@id .


:akta_wasiat rdf:type owl:NamedIndividual ,
                      :AktaWasiat ;
             :berdasarPada :aturan_uujn ;
             :perluDaftarDi :lem_ahu ;
             :penjelasanAwam "Wasiat resmi di notaris dan didaftar ke Kemenkumham." ;
             rdfs:label "Akta wasiat"@id .


#################################################################
#    Aturan hukum (sumber)
#################################################################

:aturan_fidusia rdf:type owl:NamedIndividual ,
                         :UndangUndang ;
                :penjelasanAwam "Dasar hukum jaminan utang tanpa serah barang, misalnya motor atau tanah." ;
                :sumber "UU No. 42 Tahun 1999 tentang Jaminan Fidusia dan PP No. 21 Tahun 2015 tentang Tata Cara Pendaftaran Jaminan Fidusia"@id ;
                rdfs:label "UU Fidusia 42/1999"@id .


:aturan_kawin rdf:type owl:NamedIndividual ,
                       :UndangUndang ;
              :penjelasanAwam "Aturan perkawinan, termasuk nyatanya hak milik bersama sejak pasangan nikah." ;
              :sumber "UU No. 1 Tahun 1974 tentang Perkawinan dan Putusan MK No. 69/PUU-XIII/2015"@id ;
              rdfs:label "UU Perkawinan + MK 69/2015"@id .


:aturan_ppat rdf:type owl:NamedIndividual ,
                      :PeraturanPemerintah ;
             :terkaitAturan :aturan_tanah ;
             :penjelasanAwam "Aturan khusus akta tanah." ;
             :sumber "PP No. 24 Tahun 2016 tentang Perubahan atas PP No. 37 Tahun 1998 tentang Peraturan Jabatan Pejabat Pembuat Akta Tanah"@id ;
             rdfs:label "Aturan PPAT (PP 24/2016)"@id .


:aturan_pt rdf:type owl:NamedIndividual ,
                    :UndangUndang ;
           :penjelasanAwam "Dasar pendirian perusahaan, termasuk PT perorangan dengan satu pemilik." ;
           :sumber "UU No. 40 Tahun 2007 tentang Perseroan Terbatas sebagaimana diubah UU No. 11 Tahun 2020 tentang Cipta Kerja"@id ;
           rdfs:label "UU PT + Cipta Kerja PT perorangan"@id .


:aturan_tanah rdf:type owl:NamedIndividual ,
                       :AturanHukum ;
              :penjelasanAwam "Dasar hak atas tanah dan pendaftaran SHM, HGB, atau hak pakai." ;
              :sumber "UU No. 5 Tahun 1960 tentang Peraturan Dasar Pokok-Pokok Agraria dan PP No. 18 Tahun 2021 tentang Hak Pengelolaan, Hak atas Tanah, Satuan Rumah Susun, dan Pendaftaran Tanah"@id ;
              rdfs:label "Aturan tanah (UUPA + PP 18/2021)"@id .


:aturan_uuht rdf:type owl:NamedIndividual ,
                      :UndangUndang ;
             :penjelasanAwam "UUHT No.4/1996: APHT dibuat di PPAT dan didaftar ke BPN; SKMHT hanya kuasa pendahulu yang wajib disusul APHT." ;
             :sumber "UU No. 4 Tahun 1996 tentang Hak Tanggungan atas Tanah beserta Benda-Benda yang Berkaitan dengan Tanah"@id ;
             rdfs:label "UUHT No.4/1996"@id .


:aturan_uujn rdf:type owl:NamedIndividual ,
                      :UndangUndang ;
             :terkaitAturan :aturan_ppat ;
             :penjelasanAwam "Aturan wewenang notaris dan akta otentik." ;
             :sumber "UU No. 2 Tahun 2014 tentang Perubahan atas UU No. 30 Tahun 2004 tentang Jabatan Notaris"@id ;
             rdfs:label "UUJN No.2/2014"@id .


:aturan_warisIslam rdf:type owl:NamedIndividual ,
                            :AturanHukum ;
                   :penjelasanAwam "Pembagian warisan bagi umat Islam, memakai hukum furu'ah." ;
                   :sumber "Instruksi Presiden No. 1 Tahun 1991 tentang Kompilasi Hukum Islam"@id ;
                   rdfs:label "KHI waris Islam"@id .


:aturan_warisPerdata rdf:type owl:NamedIndividual ,
                              :AturanHukum ;
                     :penjelasanAwam "Pembagian warisan bagi yang berlaku hukum perdata, bukan hukum Islam." ;
                     :sumber "Kitab Undang-Undang Hukum Perdata (Burgerlijk Wetboek)"@id ;
                     rdfs:label "KUHPerdata waris"@id .


