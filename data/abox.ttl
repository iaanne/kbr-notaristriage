#################################################################

:lem_ahu rdf:type owl:NamedIndividual ,
                  :Lembaga ;
         :penjelasanAwam "Sistem online untuk pengesahan PT, CV, fidusia, wasiat." ;
         rdfs:label "AHU Kemenkumham"@id .


:lem_bpn rdf:type owl:NamedIndividual ,
                  :Lembaga ;
         :penjelasanAwam "Kantor pertanahan untuk balik nama sertifikat." ;
         rdfs:label "BPN / ATR"@id .


:lem_dukcapil rdf:type owl:NamedIndividual ,
                       :Lembaga ;
              :penjelasanAwam "Catatan sipil untuk KK, akta nikah, kematian, perjanjian kawin." ;
              rdfs:label "Dukcapil"@id .


:lem_notaris rdf:type owl:NamedIndividual ,
                      :Lembaga ;
             :penjelasanAwam "Pejabat yang bikin akta otentik umum: PT, fidusia, wasiat, perjanjian kawin." ;
