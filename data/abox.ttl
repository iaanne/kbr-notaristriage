:biaya_honorPPAT rdf:type owl:NamedIndividual ,
                          :KomponenBiaya ;
                 :penjelasanAwam "Honor jasa PPAT untuk akta yang dibuat di hadapannya." ;
                 rdfs:label "honorarium PPAT"@id .


